# Railway connection for scripts/db-sync.sh — copy to scripts/railway-remote.env and fill in.
# scripts/railway-remote.env is gitignored. Pull these from the Railway dashboard:
#
#   Postgres service → Variables → DATABASE_PUBLIC_URL   (the *public* proxy URL, not *.railway.internal)
#   Meilisearch service → its generated public domain     (https://…up.railway.app)
#   Meilisearch service → Variables → MEILI_MASTER_KEY

REMOTE_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
REMOTE_MEILISEARCH_HOST=https://YOUR-MEILI.up.railway.app
REMOTE_MEILISEARCH_API_KEY=YOUR_MEILI_MASTER_KEY
