DATABASE_URL="postgresql://lifeos:lifeos@localhost:5444/lifeos?schema=public"

BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

RESEND_API_KEY="re_your_key_here"

MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="lifeos-dev-key"

PUBLIC_APP_URL="http://localhost:3000"

# Optional. When set, enables POST /api/admin/reindex (used by `pnpm db:push` to make
# Railway rebuild its search index from its own DB). Leave empty to keep the endpoint disabled.
REINDEX_TOKEN=""

# Optional log level: fatal | error | warn | info | debug | trace | silent.
# Defaults to `debug` in dev and `info` in production. Set LOG_LEVEL=debug on Railway to
# enable Prisma query + request-body logging without a rebuild.
LOG_LEVEL=
