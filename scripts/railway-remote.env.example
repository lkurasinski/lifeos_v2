# Railway connection for scripts/db-sync.sh — copy to scripts/railway-remote.env and fill in.
# scripts/railway-remote.env is gitignored. Pull these from the Railway dashboard:
#
#   Postgres service → Variables → DATABASE_PUBLIC_URL   (the public proxy URL, not *.railway.internal)
#   App service      → its generated public domain        (https://…up.railway.app)
#   App service      → Variables → REINDEX_TOKEN          (a secret you set; enables /api/admin/reindex)
#
# Meilisearch needs NO entry here: after a push, the deployed app reindexes itself over
# Railway's private network, so Meili can stay private (no public domain required).

REMOTE_DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
REMOTE_APP_URL=https://YOUR-APP.up.railway.app
REMOTE_REINDEX_TOKEN=YOUR_REINDEX_TOKEN
